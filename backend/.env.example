PROJECT_NAME="AccessReaper v2"
VERSION="2.0.0"
ENV="dev"
HOST="127.0.0.1"
PORT=8100

# Auth mode: "firebase" (production ID token verification) or "dev" (local dev testing with X-Dev-User)
AUTH_MODE="firebase"
FIREBASE_PROJECT_ID="accessreaper"
FIRESTORE_DATABASE_ID="accessreaper-profiles"
ORGANIZATION_ID="acme"
FIREBASE_SERVICE_ACCOUNT_PATH="D:/AccessReaper-v2/backend/secrets/firebase-service-account.json"


# Database connection string (SQLite default; can be switched to PostgreSQL without model changes)
DATABASE_URL="sqlite:///D:/AccessReaper-v2/backend/data/accessreaper_v2.db"

# DRY_RUN guard: must be true in Phase 1
DRY_RUN=true

# Phase 3: Token Encryption & GitHub Integration
APP_ENCRYPTION_KEY="generate-with-Fernet-generate_key"
GITHUB_TOKEN=""
GITHUB_API_BASE="https://api.github.com"
GITHUB_MAX_SYNC_REQUESTS=2000

# LLM Explanations (Groq primary, Gemini fallback)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
LLM_PROVIDER_ORDER="groq,gemini"
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_FINDINGS_PER_CALL=6
LLM_SEND_REAL_NAMES=false

# Gemini Explanations & SMTP Notifications
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MAX_CALLS_PER_RUN=50

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="notifications@accessreaper.local"
PUBLIC_BASE_URL="http://localhost:8100"
